APP_NAME="Lumko Seminars"
APP_ENV=testing
APP_KEY=base64:JhGu+McCx84TSy3hVadi97Ae6gqVt/x36XIJRJn59Go=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8791

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Playwright/Stage G browser smoke suite runs against this dedicated
# SQLite file — never the real MySQL dev database (see .env). Rebuilt
# from scratch (migrate:fresh --seed) before every test run.
DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_SCHEME=https

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="test@lumko.cloud"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
