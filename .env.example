# =============================================================================
# Lumko Seminar Platform — environment template
#
# Defaults below are PRODUCTION-oriented. For local development change:
#   APP_ENV=local  APP_DEBUG=true  SESSION_SECURE_COOKIE=false
#   BROADCAST_CONNECTION=log  MAIL_MAILER=log  LOG_STACK=single
#
# Never commit a real .env. Generate APP_KEY with `php artisan key:generate`.
# After changing any value in production run `php artisan config:cache`
# (and `php artisan queue:restart` so the workers pick it up).
# =============================================================================

APP_NAME="Lumko Seminars"
APP_ENV=production
APP_KEY=
# Must be false in production: true prints stack traces and secrets to visitors.
APP_DEBUG=false
APP_URL=https://seminar.lumko.cloud
# All event times are stored and shown as SAST wall-clock time.
APP_TIMEZONE=Africa/Johannesburg

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Reverse proxy / load balancer -------------------------------------------
# Needed when TLS is terminated in front of PHP (proxy, load balancer, CDN).
# Without it, signed email links come out as http:// and fail. Use "*" only if
# the app is reachable solely through your proxy, otherwise a comma-separated
# list of proxy IPs/CIDRs, e.g. TRUSTED_PROXIES=10.0.0.5,10.0.1.0/24
# Leave empty when the web server itself terminates TLS.
TRUSTED_PROXIES=

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
# "daily" rotates files and keeps LOG_DAILY_DAYS of them.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (MySQL / MariaDB) ----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seminar
DB_USERNAME=
DB_PASSWORD=

# --- Sessions ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. Set false only for plain-http local development.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Queue & cache -----------------------------------------------------------
# Registration confirmation, payment, reminder and announcement emails are all
# QUEUED. A queue worker MUST be running or none of them are ever sent
# (see docs/deployment.md).
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

FILESYSTEM_DISK=local

# --- Security headers --------------------------------------------------------
# Content-Security-Policy starts in report-only mode. Flip to true only after a
# rehearsal shows zero CSP violations in the browser console (docs/launch-checklist.md).
SEMINAR_CSP_ENFORCE=false

# --- Real-time (Pusher) ------------------------------------------------------
# Pusher (not Reverb) carries live Q&A, polls and reactions. Create the app in
# the cluster nearest South Africa (see docs/livestream-runbook.md). If any
# VITE_* key is empty the site degrades to polling automatically.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_SCHEME=https
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Livestream (Agora) ------------------------------------------------------
# App ID + primary certificate from the Agora console. Tokens are short-lived
# and renewed automatically by the player.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600

# --- Mail --------------------------------------------------------------------
# Use a real SMTP account on a domain with SPF, DKIM and DMARC configured.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Organiser & privacy -----------------------------------------------------
# Shown on payment instructions and in every email footer.
SEMINAR_ORGANISER_LEGAL_NAME="Lumko Business Technology Partners"
# Link to the organiser's POPIA privacy notice. When empty, NO privacy link is
# rendered — supply this before launch.
SEMINAR_PRIVACY_NOTICE_URL=

# --- Payment instructions (in-person tickets) ---------------------------------
# The admin dashboard warns while any of the first four are missing.
SEMINAR_BANK_ACCOUNT_NAME="Lumko Software Consultants (Pty) Ltd"
SEMINAR_BANK_NAME="First National Bank"
SEMINAR_BANK_ACCOUNT_NUMBER=62309518604
SEMINAR_BANK_BRANCH_CODE=250655
SEMINAR_BANK_ACCOUNT_TYPE=Cheque
SEMINAR_PAYMENT_REFERENCE_PREFIX=EVENT-

# --- Registration limits -----------------------------------------------------
# Registration submits allowed per minute from ONE IP address. Generous by
# default (30) because many registrants share an IP — a municipal office or
# venue Wi-Fi is a single public address. Each email is also always limited to
# 3 submits/hour. Behind a proxy, set TRUSTED_PROXIES or every visitor shares
# the proxy's IP and this becomes a global cap.
SEMINAR_REGISTRATION_IP_PER_MINUTE=30

# --- Retention & windows -----------------------------------------------------
# Proof-of-payment files are deleted after this many days (the payment record stays).
SEMINAR_POP_RETENTION_DAYS=180
# How long the attendee portal, resources and feedback stay open after the event.
SEMINAR_POST_EVENT_DAYS=90
SEMINAR_FEEDBACK_DAYS=30
# Allow plain-http links on resources. Leave false.
SEMINAR_ALLOW_HTTP_RESOURCE_LINKS=false

# --- Admin communications & analytics ----------------------------------------
# Admin emails go out one per person at this rate. Keep it at or below your
# SMTP host's sending limit (many hosts cap mail per hour: 60/min = 3,600/hour).
SEMINAR_MAIL_PER_MINUTE=60
# Cookieless page-hit analytics (Admin → Analytics). Behind a proxy, set
# TRUSTED_PROXIES or every visitor hashes to the proxy's IP.
SEMINAR_ANALYTICS_ENABLED=true
SEMINAR_ANALYTICS_RETENTION_DAYS=365
# Speaker report links (Event → Speakers → Send report link) expire after this many days.
SEMINAR_SPEAKER_REPORT_DAYS=30

VITE_APP_NAME="${APP_NAME}"

# Privacy Policy & Terms (config/legal.php). Unset values show as
# "[TO COMPLETE]" on /privacy and /terms. Bumping a version asks everyone
# to accept again on their next visit.
LEGAL_TERMS_VERSION=2026-09-28
LEGAL_PRIVACY_VERSION=2026-10-07
LEGAL_EFFECTIVE_DATE=2026-10-07
LEGAL_REVIEWED=false
LEGAL_COMPANY_REGISTRATION_NUMBER="K2024142455/07"
LEGAL_PHYSICAL_ADDRESS="46 St George Street, Bloemfontein, 9301, South Africa"
LEGAL_CONTACT_EMAIL="seminar@lumko.cloud"
LEGAL_INFORMATION_OFFICER_NAME="Tshepo Blom"
LEGAL_INFORMATION_OFFICER_EMAIL="tshepoblom@lumko.cloud/083 432 8499"
LEGAL_HOSTING_PROVIDER="Lumko Business Technology Partners"
LEGAL_REFUND_POLICY="Refunds are not available for in-person tickets."
